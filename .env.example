# Usa tu suscripción de Claude mediante Claude Code (no necesita API key).
# Requisito: haber iniciado sesión una vez con `claude` -> /login.
# Modelo: alias de Claude Code (opus, sonnet, haiku) o un ID completo
CLAUDE_MODEL=opus
CLAUDE_EFFORT=medium
WHISPER_MODEL=large-v3-turbo
WHISPER_LANG=es
# int8_float16 usa la mitad de VRAM que float16 (útil si un juego la llena). beam 1 = más rápido.
WHISPER_COMPUTE=int8_float16
WHISPER_BEAM=1
# Si la GPU no termina en estos segundos (juego acaparándola), se transcribe también en la CPU con este modelo.
# Dejar WHISPER_FALLBACK_MODEL vacío para desactivarlo.
WHISPER_FALLBACK_MODEL=small
WHISPER_FALLBACK_AFTER=1.2
# Pantalla al iniciar: principal | mouse | todos | 1, 2... (se puede cambiar en la ventana)
MONITOR=principal
# Mantener para hablar: combinación (ctrl+win, ctrl+alt…) o una tecla (f7)
HOTKEY_ALL=ctrl+win
HOTKEY_SHOT=f8
HOTKEY_MIC=f9
HOTKEY_SEND=f10
HOTKEY_VOICE=f11
# Alterna entre la ventana y el overlay para jugar (tarjeta compacta encima del juego, no toma el foco)
HOTKEY_OVERLAY=f6
# Overlay: top-right | top-left | top-center | bottom-right | bottom-left | bottom-center (en el monitor que se captura)
OVERLAY_POSITION=top-right
OVERLAY_MARGIN=24
# Segundos sin actividad antes de que el overlay se reduzca a una pastilla
OVERLAY_IDLE=20
# Lectura en voz alta (edge-tts, gratis, requiere internet). Voces: es-CL-CatalinaNeural, es-CL-LorenzoNeural,
# es-MX-DaliaNeural, es-ES-AlvaroNeural… (lista completa: edge-tts --list-voices)
TTS_ENABLED=1
TTS_VOICE=es-CL-CatalinaNeural
TTS_RATE=+5%

# Búsqueda web de la versión del juego: once (una vez por juego), always (cada consulta), off
GAME_SEARCH=once

# F7: auto = Claude decide si necesita ver la captura (ahorra tokens); always = siempre la envía
F7_SCREENSHOT=auto

# Ruteo por tarea: cada consulta parte en el modelo rápido; si es compleja, la pasa a CLAUDE_MODEL/CLAUDE_EFFORT.
# CLAUDE_MODEL_FAST vacío = siempre CLAUDE_MODEL. Esfuerzo: low, medium, high, xhigh, max
CLAUDE_MODEL_FAST=opus
CLAUDE_EFFORT_FAST=low

# Al abrir: overlay (widget para jugar; F6 alterna con la ventana) o ventana
START_MODE=overlay

# Acciones en el PC tipo Jarvis (abrir apps/webs/Spotify, mover ventanas, multimedia). 0 = desactivado
PC_ACTIONS=1
